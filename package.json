{
  "name": "tgcloud-broadcast-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot on Telegram Serverless (tgcloud) that publishes one post to many channels and reports per-channel results.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "config": "node scripts/write-config.mjs",
    "deploy": "npm run config && tgcloud push",
    "migrate": "tgcloud migrate",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "test": "node --import ./test/helpers/register.js --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tgcloud/cli": "^0.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matt-hosseini-dev/tgcloud-broadcast-bot.git"
  }
}
